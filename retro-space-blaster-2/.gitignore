# Dependencies
node_modules/

# Build output (Vite → dist/client + dist/server)
dist/
coverage/

# Generated by scripts/optimize-art.mjs from art/sprites — rebuilt on every build
public/assets/sprites/

# Secrets — never commit. Devvit stores your login token outside the repo
# (in your user folder), but keep any local .env files out of git too.
.env
.env.*
!.env.example
*.pem
*.key

# Logs
*.log
npm-debug.log*

# Editor / OS
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local AI-tool settings (machine-specific permissions)
.claude/settings.local.json
